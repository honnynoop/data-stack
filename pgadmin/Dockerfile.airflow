FROM apache/airflow:2.9.1-python3.11

USER root
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow
# dbt-postgres 1.7.x = SQLAlchemy 1.4.x 호환 (Airflow 2.9.1 요구사항 충족)
# sqlalchemy 핀 제거 — Airflow 베이스 이미지가 이미 1.4.x 설치
RUN pip install --no-cache-dir \
    "dbt-postgres==1.7.17" \
    "pandas==2.2.2"
